# ---------------------------------------------------------------------------
# MarketPilot AI — environment configuration
# Copy to .env.local for development. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
NODE_ENV=development
APP_NAME="MarketPilot AI"
APP_URL=http://localhost:3000

# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=
# Used to encrypt OAuth tokens at rest (AES-256-GCM). Same generation command.
ENCRYPTION_KEY=

# --- Database -------------------------------------------------------------
# Leave EMPTY in local dev to use the embedded PostgreSQL (PGlite) in ./.pglite
# Production example: postgresql://user:pass@host:5432/marketpilot?sslmode=require
DATABASE_URL=

# --- Development / cost control ------------------------------------------
# When true, all external services (AI, image, video, voice, social publishing)
# use deterministic in-repo mock implementations. No API credits are spent.
MOCK_EXTERNAL_SERVICES=true

# --- AI providers ---------------------------------------------------------
# anthropic | openai | mock
AI_PROVIDER=mock
AI_PROVIDER_API_KEY=
AI_MODEL=claude-sonnet-5

IMAGE_PROVIDER=mock
IMAGE_PROVIDER_API_KEY=

VIDEO_PROVIDER=mock
VIDEO_PROVIDER_API_KEY=

VOICE_PROVIDER=mock
VOICE_PROVIDER_API_KEY=

# --- Object storage -------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# --- Social platform OAuth apps ------------------------------------------
# Each platform requires its own developer app. See README for approval notes.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Billing --------------------------------------------------------------
# mock | stripe
BILLING_PROVIDER=mock
BILLING_SECRET=
BILLING_WEBHOOK_SECRET=

# --- Jobs -----------------------------------------------------------------
# Run the job worker inside the Next.js process (convenient for local dev).
# In production run `npm run worker` as a separate process and set this false.
RUN_INLINE_WORKER=true

# Shared secret for POST /api/internal/worker, the queue drain used by hosts
# that cannot run an always-on process (the Netlify scheduled function calls
# it once a minute). Leave unset anywhere `npm run worker` is running: with no
# secret the endpoint refuses every request. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SECRET=
